# ============================================================
# Genemco Catalog RAG — environment configuration
# Copy this file to .env and fill in real credentials.
# All infra costs (Pinecone, OpenAI, etc.) are paid by Genemco
# per SOW Section 5 — get these keys from Gerald.
# ============================================================

# ---- Shopify (Admin API) ----
SHOPIFY_STORE_URL=genemco.myshopify.com
SHOPIFY_ADMIN_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxx
SHOPIFY_API_VERSION=2024-01

# ---- OpenAI (embeddings + FAQ + default vision) ----
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# ---- Anthropic (optional — set VISION_PROVIDER=anthropic to use Claude vision) ----
ANTHROPIC_API_KEY=
VISION_PROVIDER=openai
VISION_MODEL=gpt-4o
FAQ_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIM=3072

# ---- Vector DB ----
VECTOR_BACKEND=pinecone          # pinecone | weaviate
PINECONE_API_KEY=pcsk_xxxxxxxxxxxx
PINECONE_INDEX=genemco-rag
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
# WEAVIATE_URL=
# WEAVIATE_API_KEY=

# ---- Reranker ----
RERANKER_BACKEND=cross-encoder   # cross-encoder | cohere | none
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# COHERE_API_KEY=

# ---- Pipeline behaviour ----
NAMEPLATE_CONFIDENCE_THRESHOLD=0.7
NUMERIC_CONFLICT_TOLERANCE_PCT=5.0
EMBED_BATCH_SIZE=96
EMBED_MAX_CONCURRENCY=4
EMBED_RATE_LIMIT_PER_SEC=2.0
STREAM_C_MAX_PAIRS=15000

# ---- Data directories (defaults shown; override if Genemco drops files elsewhere) ----
# PDF_MANUALS_DIR=./data/pdf_manuals
# NAMEPLATE_DIR=./data/nameplates
# STREAM_C_DIR=./data/stream_c
